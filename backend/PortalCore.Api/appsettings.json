{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PortalLogging": {
    "Enabled": true,
    "Level": "info",
    "Console": true,
    "File": {
      "Enabled": true,
      "Directory": "logs",
      "MaxFileSizeMb": 10,
      "RetainDays": 14
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PortalDb": "Data Source=portalcore.db"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "AiSettings": {
    "Enabled": true,
    "Provider": "OpenAI",
    "KnowledgeFolder": "Data/knowledge",
    "PromptFolder": "Data/prompts",

    "KnowledgeFiles": {
      "Enabled": true
    },

    "Providers": {
      "Ollama": {
        "Endpoint": "http://localhost:11434/api/generate",
        "ApiKey": "",
        "Model": "qwen2.5:7b"
      },

      "OpenAI": {
        "Endpoint": "https://api.openai.com/v1/chat/completions",
        "ApiKey": "",
        "Model": "gpt-4.1-mini"
      }
    },

    "VectorDb": {
      "Enabled": false,
      "Provider": "Qdrant",
      "Endpoint": "http://localhost:6333",
      "Collection": "portalcore-knowledge"
    }
  }
}
