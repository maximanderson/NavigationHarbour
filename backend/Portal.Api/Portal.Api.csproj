<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The executable and assembly metadata come from product.json (see Directory.Build.props); the project and
         namespaces stay Portal.Api whatever the product is called. -->
    <AssemblyName>$(ProductTechnicalName)</AssemblyName>
    <Product>$(ProductDisplayName)</Product>
    <Description>$(ProductDescription)</Description>
    <RootNamespace>Portal.Api</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Standalone Kestrel hosting (no IIS): a small portal does not need the memory-hungry server GC. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- No IIS: do not generate web.config on publish. -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <!-- Keep the published folder small and readable: English only for the framework's resource DLLs. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Portal.Api.Tests" />
    <AssemblyMetadata Include="ProductTagline" Value="$(ProductTagline)" />
    <AssemblyMetadata Include="ProductTechnicalName" Value="$(ProductTechnicalName)" />
  </ItemGroup>

  <!--
    Published output only (development is unaffected): the development settings file is not deployed, and the
    sample AI files are not deployed into bin/. A standalone installation keeps its AI files in <home>/ai
    ([paths] ai); the build script copies the samples there once. Note: the Data folder still stays in the
    project for development (the default AiSettings folders point at it).
  -->
  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <Content Update="Data\**" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.7" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
  </ItemGroup>

</Project>
